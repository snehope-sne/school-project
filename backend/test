    <h2>Registration Form</h2>

<?php
// Check if form is submitted
if (isset($_POST['submit'])) {
    // Capture form data
    $username = $_POST['username'];
    $password = $_POST['password'];
    $confirmPassword = $_POST['confirm_password'];
    $email = $_POST['email'];
    
    // Simple validation using if-else
    if (empty($username)) {
        echo "<div class='message error'>Username is required.</div>";
    } elseif (empty($email)) {
        echo "<div class='message error'>Email is required.</div>";
    } elseif (empty($password)) {
        echo "<div class='message error'>Password is required.</div>";
    } elseif (empty($confirmPassword)) {
        echo "<div class='message error'>Confirm Password is required.</div>";
    } elseif ($password !== $confirmPassword) {
        echo "<div class='message error'>Passwords do not match. Please try again.</div>";
    } else {
        // All validations passed
        echo "<div class='message success'>Registration successful, Welcome " . htmlspecialchars($username) . "!</div>";
    }
}
?>

